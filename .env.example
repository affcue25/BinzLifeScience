# Copy this file to .env.local and edit it.

# REQUIRED in production. Any long random string (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a built-in insecure fallback is used if this is empty.
AUTH_SECRET=

# Admin sign-up page. The FIRST admin can always sign up at /admin/signup.
# After that, sign-up stays closed unless you set this to true.
ALLOW_ADMIN_SIGNUP=false

# Supabase. Project Settings → API.
# Run supabase/schema.sql once in the Supabase SQL Editor before starting the site.
NEXT_PUBLIC_SUPABASE_URL=
# service_role secret. Server only. Do not use the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to true only if you run `npm start` over plain http on a server
# (not localhost) and the login cookie is not being saved.
# INSECURE_COOKIES=false
